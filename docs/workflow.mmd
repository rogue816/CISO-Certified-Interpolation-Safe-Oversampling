flowchart TD
    subgraph CORE["Core implementation"]
        A1[ciso.py<br/>sampler, 3 phases, certificate] --> A2[registry.py<br/>17 methods]
        A2 --> A3[engine.py<br/>3x5 stratified CV]
        A3 --> A4[metrics.py<br/>PR-AUC, ROC-AUC, G-mean]
    end

    subgraph D["1 - Data"]
        B1[data/keel/<br/>42 files] --> B2[loaders.py] --> B3[validate_keel.py]
